{
  "name": "typescript-kata-starter",
  "version": "1.0.0",
  "description": "A starting point for the Typescript npm kata.",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "start": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcklenAvenue/coin-kata-typescript.git"
  },
  "author": "Byron Sommardahl",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AcklenAvenue/coin-kata-typescript/issues"
  },
  "homepage": "https://github.com/AcklenAvenue/coin-kata-typescript#readme",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0"
  }
}
